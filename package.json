{
  "name": "rental-home-search-2026",
  "private": true,
  "version": "0.1.0",
  "description": "Weighted scoring tool for rental homes in Soka City, Saitama",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run data:web && tsc --noEmit && vite build",
    "preview": "vite preview",
    "scrape": "tsx scripts/scrape.ts",
    "scrape:athome": "tsx scripts/scrape-athome.ts",
    "scrape:roomspot": "tsx scripts/scrape-roomspot.ts",
    "scrape:all": "npm run scrape && npm run scrape:athome && npm run scrape:roomspot",
    "refresh": "tsx scripts/refresh.ts",
    "refresh:resume": "tsx scripts/refresh.ts --resume",
    "refresh:status": "tsx scripts/refresh-status.ts",
    "refresh:plan": "tsx scripts/refresh.ts --resume --plan",
    "capture:import": "tsx scripts/import-capture.ts",
    "capture:athome-html": "tsx scripts/import-athome-html.ts",
    "detail:enrich": "tsx scripts/enrich-details.ts",
    "enrich": "tsx scripts/enrich.ts --quiet",
    "import:nifty": "tsx scripts/merge-nifty.ts",
    "data:status": "tsx scripts/data.ts status",
    "data:build": "tsx scripts/data.ts build",
    "data:web": "tsx scripts/build-web-data.ts",
    "data:migrate": "tsx scripts/migrate-sources.ts",
    "dedup": "tsx scripts/merge-duplicates.ts",
    "test": "vitest run",
    "rank": "tsx scripts/rank.ts",
    "find:new": "tsx scripts/find-new.ts",
    "data:backfill": "tsx scripts/backfill-suumo.ts",
    "crawl:nifty": "tsx scripts/crawl-nifty.ts",
    "backfill:parking": "tsx scripts/backfill-parking.ts --quiet"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "cheerio": "^1.2.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.4",
    "vitest": "^4.1.11"
  }
}
